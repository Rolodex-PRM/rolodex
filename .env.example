# Rolodex environment
# Copy this file to .env. Docker Compose, the API, and the CardDAV server read it.
# `pnpm dev:web` reads it too, and passes EXPO_PUBLIC_* into the browser bundle.
#
# Production
# - Docker publishes one HTTP port, PORT, default 8080.
#   http://<host>:8080/ is the website, /api, and phone sync.
#   A LAN address, a DNS name, or a Cloudflare tunnel all point at that port.
#   TLS belongs to the tunnel or the proxy in front. Rolodex itself stays HTTP.
# - Set PUBLIC_URL only when phones should use a different origin than the browser,
#   for example https://rolodex.example.com
# - The sample POSTGRES_PASSWORD and CREDENTIALS_KEY below are live defaults.
#   Replace them before anyone else can reach the machine. If the database volume already exists,
#   change POSTGRES_PASSWORD here and inside Postgres together.
# - Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# - Registration is invite-only after the first administrator. Change it under Admin, Security.
# - Set EXPO_PUBLIC_API_URL only for the Expo dev server. The Docker build calls /api on the same host.
#
# Host ports
# Postgres is published on 127.0.0.1 for local development and backups.
# API_PORT and CARDDAV_PORT are for pnpm dev. Docker does not publish them.
# S3_* is for pnpm dev. Docker stores files in the uploads volume unless DOCKER_S3_ENDPOINT is set.
# After a port change: docker compose up -d

# --- Host ports ---
POSTGRES_PORT=5472
S3_PORT=9100
S3_CONSOLE_PORT=9101
API_PORT=4100
CARDDAV_PORT=4101
# One public port for Docker. Open http://<this-machine>:8080/
PORT=8080
WEB_DEV_PORT=4181

# --- Database ---
# Local processes use the published port. Compose points the API at postgres:5432 itself.
# Production: use a long password and, if Postgres is not on this machine, its hostname.
POSTGRES_USER=rolodex
POSTGRES_PASSWORD=rolodex
POSTGRES_DB=rolodex
DATABASE_URL=postgres://rolodex:rolodex@localhost:5472/rolodex

# --- HTTP ---
# Local development. Docker uses the address in the browser unless PUBLIC_URL is set.
PUBLIC_APP_URL=http://localhost:4181
# Browser origins allowed to call the API with cookies during local development.
CORS_ORIGIN=http://localhost:4181,http://localhost:4180
# Set true when a local API is reached over HTTPS. Docker reads the forwarded protocol instead.
COOKIE_SECURE=false
# Dev server only. The Docker site calls /api on the same host.
EXPO_PUBLIC_API_URL=http://localhost:4100
# Dev CardDAV. Docker phones use the site address, or PUBLIC_URL when that should differ.
PUBLIC_CARDDAV_URL=http://localhost:4101
# PUBLIC_URL=https://rolodex.example.com
# Extra plugin folders. The plugins directory in the project and DATA_DIR/plugins are always read.
# PLUGINS_DIR=

# --- Secrets ---
# 32 bytes, base64. The sample below is for local development only.
CREDENTIALS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Object storage (S3-compatible) ---
# Used by pnpm dev. Start it with: docker compose --profile s3 up minio -d
# Docker self-hosting stores files on disk. Set DOCKER_S3_ENDPOINT to keep using S3 there.
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=rolodex
S3_SECRET_KEY=rolodexsecret
S3_BUCKET=rolodex

# --- Backups ---
BACKUP_DIR=./backups

# --- Optional maps ---
# Leave blank to use OpenStreetMap. Either key can also be saved in Admin.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
