# Rolodex environment
# Copy this file to .env. Docker Compose, the API, and the CardDAV server read it.
# `pnpm dev:web` reads it too, and passes EXPO_PUBLIC_* into the browser bundle.
#
# Production
# - Set PUBLIC_HOST to the name or address browsers and phones use, before the first Docker start.
#   One address serves the website, /api, and phone sync.
#   https://PUBLIC_HOST/ when WEB_TLS_PORT is 443, otherwise https://PUBLIC_HOST:WEB_TLS_PORT/
#   The web image redirects WEB_PORT to that address and generates a certificate.
#   If a certificate was already created without PUBLIC_HOST, delete the certs volume and start again.
# - The sample POSTGRES_PASSWORD, S3_SECRET_KEY, and CREDENTIALS_KEY below are live defaults.
#   Replace them before anyone else can reach the machine. If the database volume already exists,
#   change POSTGRES_PASSWORD here and inside Postgres together.
# - Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# - Phones use the same address as the website. Trust the generated certificate and leave SSL on.
# - COOKIE_SECURE can stay false behind the Docker web image, which tells the API the request was HTTPS.
#   Set it true when you terminate TLS yourself in front of the API.
# - Registration is invite-only after the first administrator. Change it under Admin, Security.
# - The Docker web image proxies /api to the API container. Set EXPO_PUBLIC_API_URL only for the Expo dev server, or pass it as a build arg when the browser should call another origin.
#
# Host ports
# Postgres and object storage are published on 127.0.0.1 only.
# Set PUBLIC_HOST to the name browsers and phones use, for example rolodex.demo.com.
# Docker publishes the website on WEB_PORT and WEB_TLS_PORT. Use 80 and 443 for https://PUBLIC_HOST/.
# If those ports are taken, use another pair, such as 4180 and 4443. The public address then includes the TLS port.
# API_PORT and CARDDAV_PORT are for pnpm dev. Docker keeps those listeners on 127.0.0.1.
# Inside the Compose network, Postgres stays on 5432, object storage on 9000, the API on 3000, and CardDAV on 3001.
# After a port change: docker compose up -d

# --- Host ports ---
POSTGRES_PORT=5472
S3_PORT=9100
S3_CONSOLE_PORT=9101
API_PORT=4100
CARDDAV_PORT=4101
# Docker website. 80 and 443 make the public address https://PUBLIC_HOST/ with no port.
# Use 4180 and 4443 when this machine already serves something else on 80 and 443.
WEB_PORT=80
WEB_TLS_PORT=443
WEB_DEV_PORT=4181
PUBLIC_HOST=

# --- Database ---
# Local processes use the published port. Compose points the API at postgres:5432 itself.
# Production: use a long password and, if Postgres is not on this machine, its hostname.
POSTGRES_USER=rolodex
POSTGRES_PASSWORD=rolodex
POSTGRES_DB=rolodex
DATABASE_URL=postgres://rolodex:rolodex@localhost:5472/rolodex

# --- HTTP ---
# Public site URL used when building links. Production: https://rolodex.example.com
PUBLIC_APP_URL=http://localhost:4181
# Browser origins allowed to call the API with cookies. Comma-separated, no spaces required.
# Production: https://rolodex.example.com
CORS_ORIGIN=http://localhost:4181,http://localhost:4180
# Set true when the API is reached over HTTPS.
COOKIE_SECURE=false
# API origin baked into the web app. No trailing slash.
# Production: https://rolodex.example.com
EXPO_PUBLIC_API_URL=http://localhost:4100
# CardDAV and CalDAV origin given to phones. Production: https://dav.example.com
PUBLIC_CARDDAV_URL=http://localhost:4101

# --- Secrets ---
# 32 bytes, base64. The sample below is for local development only.
CREDENTIALS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Object storage (S3-compatible) ---
# Local API talks to the published port. Compose points the API container at http://minio:9000.
# Production: https://s3.example.com
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=rolodex
S3_SECRET_KEY=rolodexsecret
S3_BUCKET=rolodex

# --- Backups ---
BACKUP_DIR=./backups

# --- Optional maps ---
# Leave blank to use OpenStreetMap. Either key can also be saved in Admin.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
