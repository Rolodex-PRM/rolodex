FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/mobile ./apps/mobile
# Empty means the browser calls /api on the same host, which nginx proxies to the API container.
ARG EXPO_PUBLIC_API_URL=
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile --filter @rolodex/mobile... \
  && pnpm --filter @rolodex/mobile export

FROM nginx:1.27-alpine
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/dav-proxy.conf /etc/nginx/dav-proxy.conf
COPY nginx/wait-certs.sh /wait-certs.sh
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
ENTRYPOINT ["sh", "/wait-certs.sh"]
