{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rolodex.gallini.xyz/plugin-entry.schema.json",
  "title": "Rolodex plugin registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "entry", "repo", "path"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "minLength": 1, "maxLength": 20 },
    "description": { "type": "string", "maxLength": 200 },
    "entry": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+\\.html$" },
    "settings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "type": { "type": "string", "enum": ["text", "boolean"] }
        }
      }
    },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": { "type": "string", "maxLength": 60 }
  }
}
