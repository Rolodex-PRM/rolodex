{
  "name": "rolodex",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:api": "pnpm --filter @rolodex/api dev",
    "dev:carddav": "pnpm --filter @rolodex/carddav dev",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "db:migrate": "pnpm --filter @rolodex/db migrate",
    "db:generate": "pnpm --filter @rolodex/db generate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "esbuild": "^0.28.2",
      "tinypool": "^2.1.1",
      "multer": "^2.5.0",
      "zod": "^4.6.7",
      "node-forge": "^1.4.3",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
